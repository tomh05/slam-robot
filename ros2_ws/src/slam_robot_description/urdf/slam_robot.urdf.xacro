<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="slamrobot">

  <!--
    Tracked robot model for RViz2 RobotModel.
    - Body (chassis) is a box
    - Each track is represented as 2 cylinders with a box between them
  -->

  <xacro:arg name="track_separation" default="0.155" />
  <xacro:arg name="track_contact_length" default="0.127" />
  <xacro:arg name="track_overall_length" default="0.185" />
  <xacro:arg name="track_width" default="0.042" />
  <xacro:arg name="track_height" default="0.058" />
  <xacro:arg name="chassis_length" default="0.170" />
  <xacro:arg name="chassis_width" default="0.095" />
  <xacro:arg name="chassis_height" default="0.003" />
  <xacro:arg name="base_link_z" default="0.0445" />
  <xacro:arg name="lidar_x" default="0.0" />
  <xacro:arg name="lidar_y" default="0.0" />
  <xacro:arg name="lidar_z" default="0.0555" />
  <xacro:arg name="lidar_yaw" default="${pi - 7*pi/180}" /> <!-- 173 degrees -->

  <!-- BM160 IMU pose/orientation. Measured and aligned to the physical module.
       REP-103 target: +X forward, +Y left, +Z up. The bm160_imu_node publishes
       raw sensor axes in imu_link, so base_link->imu_link must reflect the
       physical sensor frame orientation.

       Observed (static, level): z=+9.81. Tilting forward gave y=+9.81,
       backward y=-9.81; tilting right side gave x=+9.81, left x=-9.81.
       => sensor frame is (right, forward, up) relative to base_link, i.e.
       yaw = -pi/2 from base_link to imu_link. Verified: rotating robot
       left/CCW (viewed from above) gives angular_velocity.z > 0.

       Measured physical mount (2026-07-30): 6.5 cm forward of robot centre,
       3.5 cm to the right of robot centre, 8 cm above the ground plane.
       REP-103: forward = +X, right = -Y, up = +Z.
       NOTE: in two_d_mode the EKF ignores z; imu_z only affects RViz display.
       The x/y offset matters if IMU linear accel is ever fused (lever-arm
       term scales with yaw rate squared), so keep it accurate. -->
  <xacro:arg name="imu_x" default="0.065" />
  <xacro:arg name="imu_y" default="-0.035" />
  <xacro:arg name="imu_z" default="0.08" />
  <xacro:arg name="imu_roll" default="0.0" />
  <xacro:arg name="imu_pitch" default="0.0" />
  <xacro:arg name="imu_yaw" default="-1.5707963" />

  <xacro:property name="track_separation" value="$(arg track_separation)" />
  <xacro:property name="track_contact_length" value="$(arg track_contact_length)" />
  <xacro:property name="track_overall_length" value="$(arg track_overall_length)" />
  <xacro:property name="track_width" value="$(arg track_width)" />
  <xacro:property name="track_height" value="$(arg track_height)" />
  <xacro:property name="chassis_length" value="$(arg chassis_length)" />
  <xacro:property name="chassis_width" value="$(arg chassis_width)" />
  <xacro:property name="chassis_height" value="$(arg chassis_height)" />
  <xacro:property name="base_link_z" value="$(arg base_link_z)" />
  <xacro:property name="lidar_x" value="$(arg lidar_x)" />
  <xacro:property name="lidar_y" value="$(arg lidar_y)" />
  <xacro:property name="lidar_z" value="$(arg lidar_z)" />
  <xacro:property name="lidar_yaw" value="$(arg lidar_yaw)" />
  <xacro:property name="imu_x" value="$(arg imu_x)" />
  <xacro:property name="imu_y" value="$(arg imu_y)" />
  <xacro:property name="imu_z" value="$(arg imu_z)" />
  <xacro:property name="imu_roll" value="$(arg imu_roll)" />
  <xacro:property name="imu_pitch" value="$(arg imu_pitch)" />
  <xacro:property name="imu_yaw" value="$(arg imu_yaw)" />

  <xacro:property name="wheel_radius" value="${track_height/2.0}" />
  <xacro:property name="wheel_length" value="${track_width}" />
  <xacro:property name="track_box_length" value="${track_contact_length}" />
  <xacro:property name="track_box_width" value="${track_width}" />
  <xacro:property name="track_box_height" value="${track_height * 0.4}" />

  <material name="chassis_dark">
    <color rgba="0.30 0.30 0.30 1.0" />
  </material>
  <material name="track_black">
    <color rgba="0.01 0.01 0.01 1.0" />
  </material>
  <material name="wheel_gray">
    <color rgba="0.15 0.15 0.15 1.0" />
  </material>
  <material name="lidar_blue">
    <color rgba="0.1 0.3 0.8 1.0" />
  </material>

  <link name="base_footprint" />

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0" />
  </joint>

  <!-- Robot body is a box -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="chassis_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.008" />
    </inertial>
  </link>

  <xacro:macro name="track" params="name y">
    <xacro:property name="wheel_x_offset" value="${track_contact_length/2.0}" />
    <xacro:property name="wheel_z" value="${-track_height/4.0}" />

    <!-- Front cylinder -->
    <link name="${name}_front_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
        <material name="wheel_gray" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}_front_wheel" type="fixed">
      <parent link="base_link" />
      <child link="${name}_front_wheel" />
      <origin xyz="${wheel_x_offset} ${y} ${wheel_z}" rpy="0 0 0" />
    </joint>

    <!-- Rear cylinder -->
    <link name="${name}_rear_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
        <material name="wheel_gray" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}_rear_wheel" type="fixed">
      <parent link="base_link" />
      <child link="${name}_rear_wheel" />
      <origin xyz="${-wheel_x_offset} ${y} ${wheel_z}" rpy="0 0 0" />
    </joint>

    <!-- Box between the two cylinders to represent the track belt -->
    <link name="${name}_belt">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${track_box_length} ${track_box_width} ${track_box_height}" />
        </geometry>
        <material name="track_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${track_box_length} ${track_box_width} ${track_box_height}" />
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}_belt" type="fixed">
      <parent link="base_link" />
      <child link="${name}_belt" />
      <origin xyz="0 ${y} ${wheel_z}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:track name="left_track" y="0.0775" />
  <xacro:track name="right_track" y="-0.0775" />

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.035" />
      </geometry>
      <material name="lidar_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.035" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_lidar_link" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}" />
  </joint>

  <link name="imu_link" />

  <joint name="base_link_to_imu_link" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}" />
  </joint>
</robot>
