<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="slamrobot">

  <!--
    Tracked robot model for RViz2 RobotModel.
    - Body (chassis) is a box
    - Each track is represented as 2 cylinders with a box between them
  -->

  <xacro:arg name="track_separation" default="0.155" />
  <xacro:arg name="track_contact_length" default="0.127" />
  <xacro:arg name="track_overall_length" default="0.185" />
  <xacro:arg name="track_width" default="0.042" />
  <xacro:arg name="track_height" default="0.058" />
  <xacro:arg name="chassis_length" default="0.170" />
  <xacro:arg name="chassis_width" default="0.095" />
  <xacro:arg name="chassis_height" default="0.003" />
  <xacro:arg name="base_link_z" default="0.0445" />
  <xacro:arg name="lidar_x" default="0.0" />
  <xacro:arg name="lidar_y" default="0.0" />
  <xacro:arg name="lidar_z" default="0.0555" />
  <xacro:arg name="lidar_yaw" default="0.0" />

  <xacro:property name="wheel_radius" value="${track_height/2.0}" />
  <xacro:property name="wheel_length" value="${track_width}" />
  <xacro:property name="track_box_length" value="${track_contact_length}" />
  <xacro:property name="track_box_width" value="${track_width}" />
  <xacro:property name="track_box_height" value="${track_height * 0.4}" />

  <material name="chassis_dark">
    <color rgba="0.10 0.10 0.10 1.0" />
  </material>
  <material name="track_black">
    <color rgba="0.01 0.01 0.01 1.0" />
  </material>
  <material name="wheel_gray">
    <color rgba="0.15 0.15 0.15 1.0" />
  </material>
  <material name="lidar_blue">
    <color rgba="0.1 0.3 0.8 1.0" />
  </material>

  <link name="base_footprint" />

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 $(arg base_link_z)" rpy="0 0 0" />
  </joint>

  <!-- Robot body is a box -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="$(arg chassis_length) $(arg chassis_width) $(arg chassis_height)" />
      </geometry>
      <material name="chassis_dark" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="$(arg chassis_length) $(arg chassis_width) $(arg chassis_height)" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.008" />
    </inertial>
  </link>

  <xacro:macro name="track" params="name y">
    <xacro:property name="track_center_offset_x" value="0.0" />
    <xacro:property name="wheel_x_offset" value="${track_contact_length/2.0}" />
    <xacro:property name="wheel_y" value="0.0" />
    <xacro:property name="wheel_z" value="${-track_height/4.0}" />

    <!-- Front cylinder -->
    <link name="${name}_front_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
        <material name="wheel_gray" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}_front_wheel" type="fixed">
      <parent link="base_link" />
      <child link="${name}_front_wheel" />
      <origin xyz="${wheel_x_offset} ${y} ${wheel_z}" rpy="0 0 0" />
    </joint>

    <!-- Rear cylinder -->
    <link name="${name}_rear_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
        <material name="wheel_gray" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}_rear_wheel" type="fixed">
      <parent link="base_link" />
      <child link="${name}_rear_wheel" />
      <origin xyz="${-wheel_x_offset} ${y} ${wheel_z}" rpy="0 0 0" />
    </joint>

    <!-- Box between the two cylinders to represent the track belt -->
    <link name="${name}_belt">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${track_box_length} ${track_box_width} ${track_box_height}" />
        </geometry>
        <material name="track_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="${track_box_length} ${track_box_width} ${track_box_height}" />
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}_belt" type="fixed">
      <parent link="base_link" />
      <child link="${name}_belt" />
      <origin xyz="0 ${y} ${wheel_z}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <!-- Two tracks with measured centre-to-centre separation -->
  <xacro:track name="left_track" y="0.0775" />
  <xacro:track name="right_track" y="-0.0775" />

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.035" />
      </geometry>
      <material name="lidar_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.035" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_lidar_link" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)" rpy="0 0 $(arg lidar_yaw)" />
  </joint>
</robot>
