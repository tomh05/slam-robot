<?xml version="1.0"?>
<package format="3">
  <name>slam_robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for bringing up the tracked SLAM robot ROS 2 stack.</description>
  <maintainer email="tom@example.com">Tom</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>lidar_scan_publisher</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>slam_robot_base</exec_depend>
  <exec_depend>slam_robot_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
